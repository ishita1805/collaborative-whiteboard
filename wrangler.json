  "migrations": [
    {
      "tag": "v1",
      "new_classes": ["AuthDurableObject"]
    }
  ],
  "vars": {
    "COLLABKIT_SERVER_URL": "https://collab-kit-server.ishitakabra18.workers.dev"
  }
}
